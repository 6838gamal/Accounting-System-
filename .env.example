# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل
# cp .env.example .env

# ============================================================
# الأمان — غيّر هذه القيم قبل النشر
# ============================================================
SECRET_KEY=change-this-to-a-long-random-string-in-production
SESSION_SECRET=change-this-to-another-long-random-string

# ============================================================
# التطبيق
# ============================================================
DEBUG=false

# ============================================================
# قاعدة البيانات
# عند الاستخدام مع Docker Compose لا تغيّر هذا السطر
# ============================================================
# DATABASE_URL_OVERRIDE=sqlite:////app/data/accounting.db

# ============================================================
# الترقيم (اختياري)
# ============================================================
# INVOICE_PREFIX=INV
# QUOTE_PREFIX=QT
# CONTRACT_PREFIX=CNT
